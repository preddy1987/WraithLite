# Build output directories (binaries, intermediate files)
**/bin/
**/obj/
[Dd]ebug/
[Rr]elease/
# Visual Studio cache folder
.vs/
# User-specific Visual Studio/MonoDevelop files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
# Mono crash reports
mono_crash.* 

# Visual Studio Code settings (ignore all except common shared configs)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# JetBrains Rider / IDE settings
.idea/
*.sln.iml

# Build logs and test results
[Bb]uild[Ll]og.* 
[Tt]est[Rr]esult*/ 
*.trx
*.htm
*.xml  # (Test result .xml like nunit/junit reports)
*.log  # Build logs
# Local History (VS, VS Code)
.vshistory/
.history/

# Publish/Packaging artifacts
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
# Windows app packages (UWP/WinUI)
*.appx
*.appxbundle
*.appxupload
*.msix
*.msixbundle
*.msixupload
# Windows Installer files
*.msi
*.msm
*.msp
*.cab
# Mobile app packages
*.apk
*.aab
*.ipa
# macOS/iOS app bundles and symbols
*.app
*.dSYM

# NuGet packages (if using local packages folder)
**/packages/*
!.*/packages/build/  # don’t ignore build/ in packages if present
# NuGet build artifacts
*.nupkg
*.snupkg
project.assets.json
project.lock.json
project.fragment.lock.json
# NuGet props/targets generated by dotnet SDK
*.nuget.props
*.nuget.targets

# Other IDE/tool-specific files
*.pidb       # Xamarin Android designer database
*.svclog     # Service trace logs
*.scc        # Source control binding files
*.vspscc
*.vssscc
# Resharper / analyzers
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
# TeamCity, AxoCover, NCrunch, etc.
_TeamCity*
*.dotCover
.axoCover/
*NCrunch*/
.*crunch*.local.xml
nCrunchTemp_*
# VS Code / VS analysis
.ntvs_analysis.dat
__pycache__/
*.pyc

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
