<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WraithLite.MainPage"
             BackgroundColor="Black">
    <ContentPage.Resources>
        <Color x:Key="AccentColor">#FF8C00</Color>
        <Color x:Key="PanelColor">#1E1E1E</Color>
    </ContentPage.Resources>

    <!-- Main layout grid: login row, content row (with floating panels), and command input row -->
    <Grid Padding="8" RowSpacing="8"
          RowDefinitions="Auto,*,Auto"
          ColumnDefinitions="*">
        <!-- Login Fields (top row) -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <HorizontalStackLayout Spacing="6">
                <Button x:Name="ConnectButton" Text="Play" Clicked="OnConnectClicked"
                        BackgroundColor="{StaticResource AccentColor}" TextColor="Black"
                        FontFamily="Courier New" FontSize="14"/>
                <Button x:Name="LichButton" Text="Lich" Clicked="OnLichClickedAsync"
                        BackgroundColor="{StaticResource AccentColor}" TextColor="Black"
                        FontFamily="Courier New" FontSize="14"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Content area (middle row) with floating panels inside an AbsoluteLayout -->
        <AbsoluteLayout Grid.Row="1">
            <!-- Story Window Panel -->
            <Frame x:Name="StoryWindow"
                   BackgroundColor="{StaticResource PanelColor}" BorderColor="Gray"
                   CornerRadius="2" HasShadow="False" Padding="2" Margin="3"
                   AbsoluteLayout.LayoutBounds="0,0,0.66,1"
                   AbsoluteLayout.LayoutFlags="All">
                <AbsoluteLayout>
                    <!-- Story content (title + scrollable output) -->
                    <Grid Padding="1" RowDefinitions="Auto,*"
                          AbsoluteLayout.LayoutBounds="0,0,1,1"
                          AbsoluteLayout.LayoutFlags="All">
                        <Grid Grid.Row="0" BackgroundColor="Gray"
                              HeightRequest="20"
                              InputTransparent="False">
                            <Grid.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnDragWindow" />
                            </Grid.GestureRecognizers>
                            <Label Text="Story" FontAttributes="Bold"
                                   FontFamily="Courier New" FontSize="14"
                                   TextColor="{StaticResource AccentColor}" 
                                   VerticalOptions="Center" HorizontalOptions="Start" Padding="8,0"/>
                        </Grid>

                        <ScrollView Grid.Row="1" x:Name="StoryScroll" Scrolled="OnStoryScrollScrolled">
                            <VerticalStackLayout x:Name="StoryOutputStack" />
                        </ScrollView>
                    </Grid>
                    <!-- Resizable grips for StoryWindow -->
                    <!-- Left edge grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="Left"
                            AbsoluteLayout.LayoutBounds="0,0,5,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Right edge grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="Right"
                            AbsoluteLayout.LayoutBounds="1,0,5,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional,XProportional"
                            AnchorX="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Top edge grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="Top"
                            AbsoluteLayout.LayoutBounds="0,0,1,5"
                            AbsoluteLayout.LayoutFlags="WidthProportional">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Bottom edge grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="Bottom"
                            AbsoluteLayout.LayoutBounds="0,1,1,5"
                            AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                            AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Top-left corner grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="TopLeft"
                            AbsoluteLayout.LayoutBounds="0,0,20,20"
                            AbsoluteLayout.LayoutFlags="None">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Top-right corner grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="TopRight"
                            AbsoluteLayout.LayoutBounds="1,0,20,20"
                            AbsoluteLayout.LayoutFlags="XProportional"
                            AnchorX="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Bottom-left corner grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="BottomLeft"
                            AbsoluteLayout.LayoutBounds="0,1,20,20"
                            AbsoluteLayout.LayoutFlags="YProportional"
                            AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <!-- Bottom-right corner grip -->
                    <BoxView Color="Transparent"
                             InputTransparent="False"
                             ClassId="BottomRight"
                            AbsoluteLayout.LayoutBounds="1,1,20,20"
                            AbsoluteLayout.LayoutFlags="XProportional,YProportional"
                            AnchorX="1" AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                </AbsoluteLayout>
            </Frame>

            <!-- Thoughts Window Panel -->
            <Frame x:Name="ThoughtsWindow"
                   BackgroundColor="{StaticResource PanelColor}" BorderColor="Gray"
                   CornerRadius="2" HasShadow="False" Padding="2" Margin="3"
                   AbsoluteLayout.LayoutBounds="1,0,0.33,0.5"
                   AbsoluteLayout.LayoutFlags="All">
                <AbsoluteLayout>
                    <Grid Padding="1" RowDefinitions="Auto,*"
                          AbsoluteLayout.LayoutBounds="0,0,1,1"
                          AbsoluteLayout.LayoutFlags="All">
                        <Grid Grid.Row="0" BackgroundColor="Gray"
                              HeightRequest="20"
                              InputTransparent="False">
                            <Grid.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnDragWindow" />
                            </Grid.GestureRecognizers>
                            <Label Text="Thoughts" FontAttributes="Bold"
                                   FontFamily="Courier New" FontSize="14"
                                   TextColor="{StaticResource AccentColor}" 
                                   VerticalOptions="Center" HorizontalOptions="Start" Padding="8,0"/>
                        </Grid>
                        <ScrollView Grid.Row="1" x:Name="ThoughtsScroll" Scrolled="OnThoughtsScrollScrolled">
                            <VerticalStackLayout x:Name="ThoughtsOutputStack" />
                        </ScrollView>
                    </Grid>
                    <!-- Resizable grips for ThoughtsWindow -->
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,0,5,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="1,0,5,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional,XProportional"
                            AnchorX="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,0,1,5"
                            AbsoluteLayout.LayoutFlags="WidthProportional">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,1,1,5"
                            AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                            AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,0,20,20"
                            AbsoluteLayout.LayoutFlags="None">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="1,0,20,20"
                            AbsoluteLayout.LayoutFlags="XProportional"
                            AnchorX="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,1,20,20"
                            AbsoluteLayout.LayoutFlags="YProportional"
                            AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="1,1,20,20"
                            AbsoluteLayout.LayoutFlags="XProportional,YProportional"
                            AnchorX="1" AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                </AbsoluteLayout>
            </Frame>

            <!-- Speech Window Panel -->
            <Frame x:Name="SpeechWindow"
                   BackgroundColor="{StaticResource PanelColor}" BorderColor="Gray"
                   CornerRadius="2" HasShadow="False" Padding="2" Margin="3"
                   AbsoluteLayout.LayoutBounds="1,1,0.33,0.5"
                   AbsoluteLayout.LayoutFlags="All">
                <AbsoluteLayout>
                    <Grid Padding="1" RowDefinitions="Auto,*"
                          AbsoluteLayout.LayoutBounds="0,0,1,1"
                          AbsoluteLayout.LayoutFlags="All">
                        <Grid Grid.Row="0" BackgroundColor="Gray"
                              HeightRequest="20"
                              InputTransparent="False">
                            <Grid.GestureRecognizers>
                                <PanGestureRecognizer PanUpdated="OnDragWindow" />
                            </Grid.GestureRecognizers>
                            <Label Text="Speech" FontAttributes="Bold"
                                   FontFamily="Courier New" FontSize="14"
                                   TextColor="{StaticResource AccentColor}" 
                                   VerticalOptions="Center" HorizontalOptions="Start" Padding="8,0"/>
                        </Grid>
                        <ScrollView Grid.Row="1" x:Name="SpeechScroll" Scrolled="OnSpeechScrollScrolled">
                            <VerticalStackLayout x:Name="SpeechOutputStack" />
                        </ScrollView>
                    </Grid>
                    <!-- Resizable grips for SpeechWindow -->
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,0,5,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="1,0,5,1"
                            AbsoluteLayout.LayoutFlags="HeightProportional,XProportional"
                            AnchorX="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,0,1,5"
                            AbsoluteLayout.LayoutFlags="WidthProportional">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,1,1,5"
                            AbsoluteLayout.LayoutFlags="WidthProportional,YProportional"
                            AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,0,20,20"
                            AbsoluteLayout.LayoutFlags="None">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="1,0,20,20"
                            AbsoluteLayout.LayoutFlags="XProportional"
                            AnchorX="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="0,1,20,20"
                            AbsoluteLayout.LayoutFlags="YProportional"
                            AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView Color="Transparent"
                            AbsoluteLayout.LayoutBounds="1,1,20,20"
                            AbsoluteLayout.LayoutFlags="XProportional,YProportional"
                            AnchorX="1" AnchorY="1">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnResizeEdge" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                </AbsoluteLayout>
            </Frame>
        </AbsoluteLayout>

        <!-- Command Input bar (bottom row) -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <Entry x:Name="CommandEntry" Grid.Column="0"
                   Placeholder="Enter command..." Completed="OnCommandEntered"
                   FontFamily="Courier New" FontSize="14"
                   BackgroundColor="{StaticResource PanelColor}" TextColor="White"/>
            <Button Text="Send" Grid.Column="1" Clicked="OnCommandEntered"
                    FontFamily="Courier New" FontSize="14"
                    BackgroundColor="{StaticResource AccentColor}" TextColor="Black"
                    Padding="12,6"/>
        </Grid>
    </Grid>
</ContentPage>
